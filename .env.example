# Environment configuration for Agent Bench.
#
# Copy this file to `.env` and fill in the keys you need:
#     cp .env.example .env
#
# You only need the keys for the frameworks you intend to run.

# --- Framework runtime credentials -----------------------------------------

# Anthropic Agent SDK
ANTHROPIC_API_KEY=your-api-key-here

# OpenAI Agents SDK, and the default OpenAI-backed runs in
# LangGraph, Pydantic AI, CrewAI, and AutoGen
OPENAI_API_KEY=your-openai-api-key-here

# Google ADK, and Gemini-backed runs in LangGraph / Pydantic AI
GOOGLE_API_KEY=your-google-ai-studio-key-here

# Framework-quality judging (LLM judge configured in evaluation/judge-model.yml)
GEMINI_API_KEY=your-google-ai-studio-key-here

# --- Optional: per-framework model overrides --------------------------------

# Each runner falls back to its own default when these are unset.
# OPENAI_AGENT_MODEL=gpt-5.4
# LANGGRAPH_MODEL=gpt-5.4            # or gemini-3.1-pro-preview
# PYDANTIC_AI_MODEL=gpt-5.4          # or gemini-3.1-pro-preview
# GOOGLE_ADK_MODEL=gemini-3.1-pro-preview
# CREWAI_MODEL=gpt-5.4
# AUTOGEN_MODEL=gpt-5.4
# OPENAI_MODEL=gpt-5.4               # shared OpenAI fallback
# GEMINI_MODEL=gemini-3.1-pro-preview # shared Google fallback

# --- Optional: cost estimation ----------------------------------------------
#
# Frameworks that report token usage but not a dollar cost need a price to
# populate `cost.value` in run_result.json. When these are unset, cost is
# recorded as null instead of being guessed.
#
# Prices are expressed in USD per 1,000,000 tokens.
# OPENAI_INPUT_COST_PER_1M=0.0
# OPENAI_OUTPUT_COST_PER_1M=0.0
